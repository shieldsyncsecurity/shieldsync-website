{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "shieldsync-website",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // NOTE on Error 1102 ("Worker exceeded resource limits"):
  // The old `usage_model: "unbound"` we tried was deprecated/ignored, and the
  // modern `limits.cpu_ms` requires the Workers Paid Standard plan ($5/mo).
  // Free plan = 10ms CPU; that's what's tripping 1102 on heavy pages.
  // Real fixes: (a) upgrade plan in CF dashboard, then re-add `limits.cpu_ms`;
  // (b) keep heavy work out of the request path (precompute at build time).
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
